#spring.application.name=hello-spring
spring:
  mvc:
    view:
      prefix: /WEB-INF/views/
      suffix: .jsp
  datasource:
    url: jdbc:oracle:thin:@localhost:1521:XE
    driver-class-name: oracle.jdbc.driver.OracleDriver
    username: SPRING_BOOT
    password: 1234
  application:
    name: hello-spring

# mybatis 연동 설정
mybatis:
  # mybatis 설정 파일 위치 지정
  config-location: classpath:mybatis-config.xml
  # mapper 파일들의 위치 지정       ** <== 중간에 이거 말고 더 있다 라는 뜻 Board, Members를 한번에 가져오는 뜻
  mapper-locations: classpath:com/ktdsuniversity/edu/**/mapper/BoardDaoMapper.xml