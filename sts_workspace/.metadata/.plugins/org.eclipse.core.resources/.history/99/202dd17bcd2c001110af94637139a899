<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ktdsuniversity.edu.board.dao.BoardDao">

    <select id="selectBoardCount" resultType="_int">
        SELECT COUNT(ID)
          FROM BOARD
    </select>

    <select id="selectBoardList" resultType="com.ktdsuniversity.edu.board.vo.BoardVO">
        SELECT ID
             , SUBJECT
             , CONTENT
             , EMAIL
             , VIEW_CNT
             , TO_CHAR(CRT_DT, 'YYYY-MM-DD HH24:MI:SS') AS CRT_DT
             , TO_CHAR(MDFY_DT, 'YYYY-MM-DD HH24:MI:SS') AS MDFY_DT
             , FILE_NAME
             , ORIGIN_FILE_NAME
          FROM BOARD
    </select>
    
    <insert id="insertNewBoard" parameterType="com.ktdsuniversity.edu.board.vo.request.WriteVO">
        <!-- 새롭게 만들어지는 게시글의 PK를 미리 생성해서 WriteVO의 id라는 변수에 할당한다. -->
         <!-- insert쿼리가 동작하기전에 동작해라 BEFORE -->
        <selectKey order="BEFORE"
                   resultType="string"
                   keyProperty="id">
            SELECT 'BO-' || TO_CHAR(SYSDATE, 'YYYYMMDD-') || LPAD(SEQ_BOARD_PK.NEXTVAL,6,'0')
              FROM DUAL
        </selectKey>
        INSERT INTO BOARD
           (ID
           , SUBJECT
           , CONTENT
           , EMAIL
           , VIEW_CNT
           , CRT_DT
           , MDFY_DT
           , FILE_NAME
           , ORIGIN_FILE_NAME)
           VALUES
           (#{id}
          , #{subject}
          , #{content}
          , #{email}
          , 0
          , SYSDATE
          , SYSDATE
          , NULL
          , NULL)
    </insert>
        
    <select id="selectBoardById" resultType="com.ktdsuniversity.edu.board.vo.BoardVO" 
    parameterType="string">
    <!-- DB에서 JOIN은 has a 로 표현한다 -->
         SELECT B.ID
		      , B.SUBJECT
		      , B.CONTENT
		      , B.EMAIL
		      , B.VIEW_CNT
		      , TO_CHAR(B.CRT_DT, 'YYYY-MM-DD HH24:MI:SS') AS CRT_DT
		      , TO_CHAR(B.MDFY_DT, 'YYYY-MM-DD HH24:MI:SS') AS MDFY_DT
		      , B.FILE_NAME
		      , B.ORIGIN_FILE_NAME
		      , F.FILE_NUM
		      , F.FILE_GROUP_ID
		      , F.OBFUSCATE_NAME
		      , F.DISPLAY_NAME
		      , F.EXTEND_NAME
		      , F.FILE_LENGTH
		      , F.FILE_PATH
		   FROM BOARD B
		   LEFT OUTER JOIN FILES F
		     ON B.ID = F.FILE_GROUP_ID 
		  WHERE ID = #{_parameter}
    </select>

    <update id="updateViewCntIncreaseById" parameterType="string">
       UPDATE SPRING_BOOT.BOARD
          SET VIEW_CNT = VIEW_CNT + 1
        WHERE ID=#{_parameter}
    </update>
    
    <delete id="deleteByOneBoard" parameterType="string">
            DELETE FROM BOARD
             WHERE ID=#{_parameter}
    </delete>
    
    <update id="updateBoardById" parameterType="com.ktdsuniversity.edu.board.vo.request.UpdateVO">
        UPDATE BOARD
           SET SUBJECT= #{subject}
             , CONTENT= #{content}
             , EMAIL= #{email}
             , MDFY_DT= SYSDATE
         WHERE ID=#{id}
    </update>
    

</mapper>