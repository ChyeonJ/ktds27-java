<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ktdsuniversity.edu.board.dao.BoardDao">

    <select id="selectBoardCount" resultType="_int">
        SELECT COUNT(ID)
          FROM BOARD
    </select>

    <select id="selectBoardList" resultType="com.ktdsuniversity.edu.board.vo.BoardVO">
        SELECT ID
             , SUBJECT
             , CONTENT
             , EMAIL
             , VIEW_CNT
             , CRT_DT
             , MDFY_DT
             , FILE_NAME
             , ORIGIN_FILE_NAME
          FROM BOARD
    </select>

</mapper>