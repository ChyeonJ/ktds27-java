<%@ page language="java" contentType="text/html; charset=UTF-8"
pageEncoding="UTF-8"%>
<%-- Directive --%>
<%-- 아래 코드 taglib Directive --%>
<%-- JSTL을 사용하기 위해서는 taglib directive필요--%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>게시글 목록</title>
    <link rel="stylesheet" type="text/css" href="/css/hello-spring.css" />
  </head>
  <body>
    <!-- HTML 주석 : 브라우저 개발자 도구 노출 -->
    <%-- JSP 주석 : 브라우저 개발자 도구 노출X --%>
    <h1>게시글 목록</h1>
    <div>총 ${searchCount} 개의 게시글이 검색되었습니다.</div>
    <table class="grid">
        <thead>
            <tr>
                <th>번호</th>
                <th>제목</th>
                <th>이메일</th>
                <th>조회수</th>
                <th>등록일</th>
                <th>수정일</th>
            </tr>
        </thead>
        <tbody>
                  <!-- 반복 대상 -->
          <c:forEach items="${searchResult}" var="board">
            <tr>
              <th>${board.id}</th>
              <th>${board.subject}</th>
              <th>${board.email}</th>
              <th>${board.viewCnt}</th>
              <th>${board.crtDt}</th>
              <th>${board.mdfyDt}</th>
            </tr>
          </c:forEach>
        </tbody>
    </table>
  </body>
</html>
