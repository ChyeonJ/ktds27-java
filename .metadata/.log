import com.ktdsuniversity.edu.store.storeproduct.FoodMenu;
import com.ktdsuniversity.edu.store.storeproduct.StoreInfo;

public class StoreManagement {
	

	private FoodMenu[] foodMenu;
	private AlcoholMenu[] alcoholMenu;
	private StoreInfo[] storeInfo;
	private Customer customer;
	
	public StoreManagement(FoodMenu index1,FoodMenu index2) {
		this.foodMenu = new FoodMenu[2];
		this.foodMenu[0] = index1;
		this.foodMenu[1] = index2;
	}
	
	public StoreManagement(AlcoholMenu index1, AlcoholMenu index2) {
		this.alcoholMenu = new AlcoholMenu[2];
		this.alcoholMenu[0] = index1;
		this.alcoholMenu[1] = index2;
	}
	
	public StoreManagement(StoreInfo index1, StoreInfo index2) {
		this.storeInfo = new StoreInfo[2];
		this.storeInfo[0] = index1;
		this.storeInfo[1] = index2;
	}
	
	public FoodMenu[] getFoodMenu() {
		return this.foodMenu;
	}
	
	public void setFoodMenu(FoodMenu[] foodMenu) {
		this.foodMenu = foodMenu;
	}
	
	public AlcoholMenu[] getAlcoholMenu() {
		return alcoholMenu;
	}
	
	public void setAlcoholMenu(AlcoholMenu[] alcoholMenu) {
		this.alcoholMenu = alcoholMenu;
	}
	
	public StoreInfo[] getStoreInfo() {
		return storeInfo;
	}
	
	public void setStoreInfo(StoreInfo[] storeInfo) {
		this.storeInfo = storeInfo;
	}
	
	public boolean fullCheck(int storeNum) {
		return this.storeInfo[storeNum].getFullStandard() == this.customer.getFull();
	}
	
	public boolean drunkCheck(int storeNum) {
		return this.storeInfo[storeNum].getDrunkStandard() == this.customer.getDrunk();
	}
	public void autoSell(Customer customer){
		
		if(this.drunkCheck() {
			
		}
		
	}
		
	}
	
}

