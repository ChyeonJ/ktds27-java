		//	- 두번째 방법
		File parentFile = textFile.getParentFile();	//많이씀 ❤
		System.out.println(parentFile);
		
		// 6. 이 파일의 경로를 출력한다.
		
		String textFilePath = textFile.getAbsolutePath();
